[Unit]
Description=Voice Assistant · dedicated Chrome with CDP (:9222)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/usr/bin/google-chrome \
  --remote-debugging-port=9222 \
  --user-data-dir=%h/.dsh-voice-chrome \
  --no-first-run --no-default-browser-check \
  --new-window http://127.0.0.1:3080
Restart=on-failure
RestartSec=5
StandardOutput=append:/tmp/dsh-voice-chrome.log
StandardError=append:/tmp/dsh-voice-chrome.log

[Install]
WantedBy=graphical-session.target
