# ── TTS 服务（:8765）────────────────────────────────────────────
TTS_PORT=8765
TTS_ENGINE=edge                    # edge | kokoro
TTS_VOICE=zh-CN-XiaoxiaoNeural     # edge 音色
TTS_RATE=+8%                       # edge 语速
TTS_MAX_CHARS=600                  # 单次朗读上限，超出截断并提示看屏幕
TTS_EDGE_FAIL_THRESHOLD=2          # edge 连续失败几次后永久降级 kokoro

# kokoro 本地引擎
TTS_KOKORO_MODEL=kokoro/kokoro-v1.0.onnx
TTS_KOKORO_VOICES=kokoro/voices-v1.0.bin
TTS_KOKORO_VOICE=zf_xiaoyi
TTS_KOKORO_SPEED=1.0

# ── 自动朗读 ───────────────────────────────────────────────────
AR_SESSIONS=~/.dsh/sessions
AR_WORKSPACE=--home-ubuntu-project-test--   # DSH 会话目录名（工作区路径转义）
AR_TTS=http://127.0.0.1:8765/speak
AR_POLL=1.5
AR_MAX_CHARS=600

# ── 语音环路 ───────────────────────────────────────────────────
VL_WAKE=小艺,小艺小艺,你好小艺,小艺助手
VL_MODEL=~/.dsh/speech-to-text/sensevoice/models/sensevoice-onnx/model.int8.onnx
VL_TOKENS=~/.dsh/speech-to-text/sensevoice/models/sensevoice-onnx/tokens.txt
VL_CMD_URL=http://127.0.0.1:8766/inject    # 留空则只识别不派发
VL_VAD=silero              # silero | energy；energy 为回退路径（无模型/初始化失败时自动回退）
VL_VAD_MODEL=~/.dsh/speech-to-text/sensevoice/models/silero/silero_vad.onnx
VL_VAD_THRESHOLD=0.5       # Silero 语音概率门限
VL_VAD_MIN_SILENCE=0.25    # 句尾静音判定（秒）：越小切得越快，低于 ~0.2 会切碎长句
# 另有 VL_VAD_MIN_SPEECH=0.25 / VL_VAD_MAX_SPEECH=10（Silero 内部最小时长与强制切分）
# 模型缺失或初始化失败时：stderr 打一条 warning，自动使用下面的能量法参数，进程不退出
VL_MARGIN=10                # [energy] VAD 阈值 = 底噪 + N dB
VL_MIN_SPEECH=0.35          # [energy] 最短语音段（秒）
VL_MAX_SPEECH=10            # [energy] 最长语音段（秒），超出强制切分
VL_END_SILENCE=0.55         # [energy] 收尾静音判定（秒）
VL_BARGE=off                # off | energy；无 AEC 时保持 off

# ── 注入桥 ─────────────────────────────────────────────────────
VB_PORT=8766
VB_CDP_SCRIPT=src/cdp/send.mjs
VB_NODE=node
VB_CDP_URL=http://127.0.0.1:9222
